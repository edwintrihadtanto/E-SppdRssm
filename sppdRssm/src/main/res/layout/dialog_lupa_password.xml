<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/bg_dialog_rounded">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lupa Password?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/hitam"
        android:fontFamily="@font/poppins_regular"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Silakan hubungi Admin IT"
        android:textSize="14sp"
        android:layout_marginTop="4dp"
        android:textColor="#666666"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#DDDDDD"/>

    <!-- EXT Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EXTENSION"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#888888"
        android:fontFamily="@font/poppins_regular"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="146 (ITISI)"
        android:textSize="16sp"
        android:textColor="@color/hitam"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_regular"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="262 (TU Umum)"
        android:textSize="16sp"
        android:textColor="@color/hitam"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="16dp"
        android:background="#DDDDDD"/>

    <!-- Contact Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="KONTAK PERSON"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="#888888"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Contact 1 -->
    <TextView
        android:id="@+id/textcp1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_regular"
        android:minHeight="48dp"
        android:padding="6dp"
        android:text="@string/nomor_edwin"
        android:textColor="#E53935"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/edwin"
        android:textSize="14sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/poppins_regular"/>

    <!-- Contact 2 -->
    <TextView
        android:id="@+id/textcp2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_regular"
        android:minHeight="48dp"
        android:padding="6dp"
        android:text="@string/nomor_reski"
        android:textColor="#E53935"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/reski"
        android:textSize="14sp"
        android:textColor="#666666"
        android:fontFamily="@font/poppins_regular"/>

</LinearLayout>