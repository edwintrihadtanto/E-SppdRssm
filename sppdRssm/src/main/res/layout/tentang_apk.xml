<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <RelativeLayout
            android:id="@+id/header_tentang"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@drawable/bg_header_modern">

            <ImageView
                android:id="@+id/logorssm"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:src="@drawable/logorssm"
                android:contentDescription="@string/todo"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/logorssm"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="8dp"
                android:text="@string/_e_sppd_"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@android:color/white"/>
        </RelativeLayout>

        <!-- CONTENT CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/headerTentang2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:layout_below="@+id/header_tentang"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tentang_aplikasi"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#D1C4E9"/>

                <TextView
                    android:id="@+id/textDeskripsi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/aplikasi_surat_perintah_perjalanan_dinas_e_sppd_digunakan_untuk_mempermudah_pengelolaan_administrasi_perjalanan_dinas_secara_digital"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="14sp"
                    android:textColor="#BBDEFB"/>

                <TextView
                    android:id="@+id/textVersi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#FFF9C4"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/copyright_2017_by_ipde_rssm_"
                    android:layout_marginTop="4dp"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="#BBDEFB"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_below="@+id/headerTentang2"
            android:gravity="center">

            <androidx.cardview.widget.CardView
                android:id="@+id/historyversi"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#E0F7FA">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/todo"
                    android:src="@drawable/ic_info"/>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/feedback"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FBE9E7">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_chat"
                    android:contentDescription="@string/todo" />
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/tutorial"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_margin="8dp"
                app:cardCornerRadius="30dp"
                app:cardElevation="5dp"
                app:cardBackgroundColor="#FFF8E1">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tutorial"
                    android:contentDescription="@string/todo" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
        <View
            android:id="@+id/grslogtengah"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignParentBottom="true"
            android:layout_centerInParent="true"
            android:background="@color/white"/>
        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_toStartOf="@+id/grslogtengah"
            android:background="@drawable/circle_reg_v1"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_alignParentBottom="true"
            android:layout_toEndOf="@+id/grslogtengah"
            android:background="@drawable/circle_reg_v2"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="@string/created_by_edwin_ipde_design_"
            android:fontFamily="@font/poppins_regular"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_above="@+id/grslogtengah"
            android:padding="5dp"
            android:textColor="@color/hitam"
            android:textStyle="bold"/>
    </RelativeLayout>

</ScrollView>
