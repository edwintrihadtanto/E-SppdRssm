<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8">

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/grslogtengahriil"
        android:background="@drawable/circle_reg_v3"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/grslogtengahriil"
        android:background="@drawable/circle_reg_v4"/>

    <View
        android:id="@+id/grslogtengahriil"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_centerHorizontal="true"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/grslogtengahriil">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/textdetailisi"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rincian_riil"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/poppins_regular" />

                    <EditText
                        android:id="@+id/edtRincian"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="5dp"
                        android:hint="@string/entry_detail_rincian_biaya_riil"
                        android:inputType="textMultiLine"
                        android:gravity="top"
                        android:selectAllOnFocus="true"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_below="@+id/textdetailisi"
                        android:importantForAutofill="no"/>

                    <TextView
                        android:id="@+id/textdetailjumlah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/biaya"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:layout_below="@+id/edtRincian"
                        android:fontFamily="@font/poppins_regular" />

                    <EditText
                        android:id="@+id/edtJumlah"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:hint="@string/entry_biaya_riil"
                        android:inputType="number"
                        android:layout_below="@+id/textdetailjumlah"
                        tools:ignore="Autofill" />

                    <TextView
                        android:id="@+id/txtTanggal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingTop="6dp"
                        android:textStyle="bold|italic"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/kuning"
                        android:layout_below="@+id/edtJumlah"/>

                    <LinearLayout
                        android:id="@+id/layoutButton"
                        style="?android:attr/buttonBarStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txtTanggal"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btn_simpanriil"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/circle_simpan2"
                            android:textColor="@color/hitam"
                            android:text="@string/simpan_riil"
                            style="?android:attr/buttonBarButtonStyle"/>

                        <Button
                            android:id="@+id/btn_hapusriil"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hapus"
                            android:background="@drawable/circle_hapus3"
                            android:textColor="@color/white"
                            android:layout_marginStart="6dp"
                            style="?android:attr/buttonBarButtonStyle"/>
                    </LinearLayout>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentBottom="true"
        android:layout_toStartOf="@+id/grslogtengahriil"
        android:background="@drawable/circle_reg_v1"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentBottom="true"
        android:layout_toEndOf="@+id/grslogtengahriil"
        android:background="@drawable/circle_reg_v2"/>
</RelativeLayout>
