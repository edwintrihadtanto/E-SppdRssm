<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F8" >

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentTop="true"
        android:layout_toStartOf="@+id/grslogtengahlistriil"
        android:background="@drawable/circle_reg_v3"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_alignParentTop="true"
        android:layout_toEndOf="@+id/grslogtengahlistriil"
        android:background="@drawable/circle_reg_v4"/>

    <View
        android:id="@+id/grslogtengahlistriil"
        android:layout_width="0dp"
        android:layout_height="10dp"
        android:layout_centerHorizontal="true"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/grslogtengahlistriil" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ================= CARD INFO SPPD ================= -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/list_item_title2"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/judulriil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/informasi_sppd"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/hitam"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/textnippegwdit"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/judulriil"
                        android:text="@string/nip"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/hitam"/>

                    <TextView
                        android:id="@+id/titikduanip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titikdua"
                        android:layout_below="@+id/judulriil"
                        android:layout_toEndOf="@+id/textnippegwdit"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginEnd="10dp"
                        android:textSize="18sp"
                        android:textColor="@color/hitam"/>

                    <TextView
                        android:id="@+id/nippeg_riil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/titikduanip"
                        android:layout_below="@+id/judulriil"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/hitam"/>

                    <TextView
                        android:id="@+id/text_lamp_sppd"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/textnippegwdit"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/no_sppd"
                        android:textColor="@color/hitam"
                        tools:ignore="TextSizeCheck" />

                    <TextView
                        android:id="@+id/titikduasppd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titikdua"
                        android:layout_below="@+id/textnippegwdit"
                        android:layout_toEndOf="@+id/textnippegwdit"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginEnd="10dp"
                        android:textSize="18sp"
                        android:textColor="@color/hitam"/>

                    <TextView
                        android:id="@+id/nosppd_riil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/titikduasppd"
                        android:layout_below="@+id/textnippegwdit"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/hitam"/>

                    <TextView
                        android:id="@+id/text_tgl_lamp"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/text_lamp_sppd"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/tgl_sppd"
                        android:textColor="@color/hitam"
                        tools:ignore="TextSizeCheck" />

                    <TextView
                        android:id="@+id/titikduatgl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/titikdua"
                        android:layout_below="@+id/text_lamp_sppd"
                        android:layout_toEndOf="@+id/textnippegwdit"
                        android:fontFamily="@font/poppins_regular"
                        android:layout_marginEnd="10dp"
                        android:textSize="18sp"
                        android:textColor="@color/hitam"/>

                    <TextView
                        android:id="@+id/tglsppd_riil"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@+id/titikduatgl"
                        android:layout_below="@+id/text_lamp_sppd"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/hitam"/>

                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- ================= CARD LIST RIIL ================= -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/juduldetailriil"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rincian_biaya_riil"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingBottom="6dp"/>

                    <!-- Container tombol -->
                    <LinearLayout
                        android:id="@+id/layoutButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/juduldetailriil"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal"
                        android:gravity="center">

                        <Button
                            android:id="@+id/btnTambahRiil"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/ic_add_circle"
                            android:background="@drawable/circle_tambah"
                            android:textColor="@color/hitam"
                            android:text="Tambah Riil"/>

                        <Button
                            android:id="@+id/btn_refresh"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/refresh"
                            android:drawableTop="@drawable/ic_refresh_black_24dp"
                            android:background="@drawable/circle_refresh"
                            android:textColor="@color/white"
                            android:layout_marginStart="6dp"
                            android:contentDescription="@string/btn_refresh"
                            tools:ignore="SpeakableTextPresentCheck"/>
                    </LinearLayout>

                    <ListView
                        android:id="@+id/listRiilBiaya"
                        android:layout_width="match_parent"
                        android:layout_height="450dp"
                        android:layout_below="@id/layoutButton"
                        android:layout_marginTop="10dp"
                        tools:ignore="NestedScrolling"/>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>