<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="15dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/list_divider"
        android:padding="10dp">

        <!-- Baris atas -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNomorUrut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="1"
                android:textStyle="bold"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/txtRincianBiaya"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Rincian biaya"
                android:fontFamily="@font/poppins_regular"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Jumlah -->
        <TextView
            android:id="@+id/txtJumlah"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rp 90.000"
            android:textColor="#F2F000"
            android:fontFamily="@font/poppins_regular"
            android:paddingTop="4dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <TextView
                android:id="@+id/txtTanggal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:drawableStart="@drawable/ic_time_white"
                android:text="2017-08-16"
                android:textColor="#00EEF2"
                android:textSize="12sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/txtinfopembuat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:paddingEnd="8dp"
                android:gravity="end"
                android:drawableEnd="@drawable/ic_user_white"
                android:textColor="#F2C200"
                android:textSize="12sp"
                android:textStyle="italic"
                android:fontFamily="@font/poppins_regular"
                tools:ignore="RtlSymmetry" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
